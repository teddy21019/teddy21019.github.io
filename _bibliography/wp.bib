@unpublished{chen2026taiwanese,
  title     = {Taiwanese Domestic Supply Chains: 2013--2022},
  author    = {Chen, Chia-Wei and Hong, Joonkyo and Komatsu, Toshiaki and Liu, Jin-Tan and Wang, Jen-Kuan},
  year      = {2026},
  pdf       = {chen2026taiwanese.pdf},
  abstract  = {This paper documents the structure of Taiwan's domestic production network from 2013 to 2022, using administrative value-added tax and business-to-business (B2B) transaction records spanning nearly all nonfinancial private-sector firms. We describe the institutional features of Taiwan's VAT system and examine the internal consistency of the data. The network has grown steadily over the sample period and is highly skewed: a small number of large firms---concentrated in wholesale, retail, and high-tech manufacturing---account for a disproportionate share of domestic linkages and transaction values. By integrating customs records, we decompose each firm's direct and indirect exposure to foreign markets. Although fewer than 15\% of firms are direct importers or exporters, most firms source inputs from importers or sell to exporters within four degrees of separation, making them susceptible to foreign shocks propagated through wholesalers, retailers, and semiconductor producers.},
}

