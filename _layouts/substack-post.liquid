---
layout: default
---
{%- comment -%}
  Substack-style blog post. Site-local layout (not an al-folio override).
  Front matter: title, subtitle (optional), date, cover (optional), tags (optional).
  Styles: assets/css/substack.css. Subscribe box: _includes/subscribe.liquid.
{%- endcomment -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,700;1,8..60,400&display=swap">
<link rel="stylesheet" href="{{ '/assets/css/substack.css' | relative_url }}">
{% feed_meta %}

{% assign words = content | strip_html | number_of_words %}
{% assign minutes = words | divided_by: 230 | at_least: 1 %}

<div class="ss">
  <header class="ss-post-header">
    <h1 class="ss-title">{{ page.title }}</h1>
    {% if page.subtitle %}
      <p class="ss-subtitle">{{ page.subtitle }}</p>
    {% endif %}
    <div class="ss-byline">
      <img src="{{ '/assets/img/prof_pic.jpg' | relative_url }}" alt="">
      <div>
        <div class="ss-author">{{ page.author | default: site.title }}</div>
        <div>
          {{ page.date | date: '%b %-d, %Y' }} · {{ minutes }} min read
          {% if page.tags.size > 0 %}
            <span class="ss-tags">
              ·
              {% for tag in page.tags %}
                <a href="{{ tag | slugify | prepend: '/blog/tag/' | relative_url }}">#{{ tag }}</a>
              {% endfor %}
            </span>
          {% endif %}
        </div>
      </div>
    </div>
  </header>

  {% if page.cover %}
    <figure class="ss-cover">
      {% if page.cover contains '://' %}
        <img src="{{ page.cover }}" alt="">
      {% else %}
        <img src="{{ page.cover | relative_url }}" alt="">
      {% endif %}
    </figure>
  {% endif %}

  <article class="ss-body">
    {{ content }}
  </article>

  {% include subscribe.liquid %}
</div>
